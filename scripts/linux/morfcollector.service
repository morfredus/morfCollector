# Service systemd pour morfCollector.
#
# Le binaire est INSTALLE dans un dossier fixe (par defaut /opt/morfcollector),
# independant du clone git. morfdeploy remplace __RUN_USER__, __APP_DIR__ et
# __CONFIG_DIR__.
#
# Trois zones (docs/FILESYSTEM.md) : PROGRAMME dans /opt, CONFIG ADMIN (lecture
# seule) dans /etc, ETAT PERSISTANT (donnees collectees + coffre chiffre) dans
# /var/lib. StateDirectory= fait creer ce dernier par systemd, possede par User=
# et accessible en ecriture, puis l'expose via $STATE_DIRECTORY. C'est ce qui
# corrige a la racine le coffre inecrivable qui laissait les sources en auth_failed.

[Unit]
Description=morfCollector - service morfSystem
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__
# Cree et possede /var/lib/morfsystem/morfcollector ; expose $STATE_DIRECTORY.
# Le service y range data/ (objets + index) et vault/ (coffre chiffre).
StateDirectory=morfsystem/morfcollector
ExecStart=__APP_DIR__/morfcollector --config __CONFIG_DIR__/morfcollector.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Durcissement (valide sur morfNotify, 2026-10-10) : systeme de fichiers en lecture
# seule. morfCollector n'ecrit que sous son StateDirectory (data/ et vault/) et ne lance
# aucun processus. ProtectHome=read-only (et non yes) : le connecteur SFTP peut lire une cle
# privee sur fichier local (key_file) et le connecteur fs des dossiers sous le home ; la
# lecture reste permise, l'ecriture est interdite.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
